param set-default NAV_ACC_RAD 0.5 			# Acceptance Radius

# Differential Parameters
param set-default RD_WHEEL_TRACK 0.335			# Distance from the center of right wheel to the center of left wheel
param set-default RD_TRANS_DRV_TRN 0.174533		# To be tuned
param set-default RD_TRANS_TRN_DRV 0.261799 		# To be tuned
param set-default RD_YAW_STK_GAIN 1.0			# To be tuned but not important

