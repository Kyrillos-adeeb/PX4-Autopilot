param set-default PP_LOOKAHD_MIN 0.5

# Attitude Control Parameters
param set-default RO_YAW_P 3.0			    	# To be tuned

# Velocity Control Parameters
param set-default RO_ACCEL_LIM 2   			# To be tuned
param set-default RO_DECEL_LIM 6		    	# To be tuned
param set-default RO_JERK_LIM 10		    	# To be tuned
param set-default RO_MAX_THR_SPEED 1			# To be tuned
param set-default RO_SPEED_LIM 1		    	# To be tuned
param set-default RO_SPEED_I 0.0    	    	# To be tuned
param set-default RO_SPEED_P 0.0		    	# To be tuned
param set-default RO_SPEED_RED -1		    	# To be tuned

